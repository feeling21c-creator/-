# RIVIAN FIELD CHECK - 환경변수 예시
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 입력하세요.
# 값이 비어 있으면 앱은 mock-data.json 기반으로 동작합니다.

# Supabase 프로젝트 URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 가전·가구 조회 외부 링크 (1차 MVP는 외부 Netlify 앱 연결)
NEXT_PUBLIC_PRODUCT_LOOKUP_URL=https://serene-buttercream-d97669.netlify.app/

# 사진 업로드용 Supabase Storage 버킷명 (Phase C에서 사용)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=field-photos
